[Unit]
Description=easy-db-dump: daily sync of %i

[Timer]
# Monday to Friday at 08:30; if the machine was off, run on next boot.
# The random delay spreads out several targets so they don't all dump at once.
OnCalendar=Mon..Fri 08:30
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
