# Copy to config/settings.env (optional; these are the defaults)

# Where dumps are stored (relative to the repo or absolute). Layout: db/YYYY/MM/
BACKUP_DIR=db

# `edd clean` deletes dumps older than this
RETENTION_DAYS=30

# If your local pg_dump is older than the RDS server ("server version mismatch"),
# use the binaries from a Docker image matching the RDS major version:
# PG_DOCKER_IMAGE=postgres:16

# --no-owner/--no-privileges avoid RDS role errors (rdsadmin, etc.) when restoring locally
PG_DUMP_EXTRA_ARGS="--no-owner --no-privileges"

# 1 = abort the restore on the first SQL error
RESTORE_STRICT=0
