# Copy this file to config/<env>.env  (e.g. config/prod.env, config/staging.env)
# The file name is the <env> you pass to: edd sync prod

# --- Remote database (AWS / RDS) ---
REMOTE_HOST=mydb.xxxxxxxx.us-east-1.rds.amazonaws.com
REMOTE_PORT=5432
REMOTE_USER=postgres
REMOTE_DB=dbname

# Remote password — pick ONE option (most to least recommended):
#  1) ~/.pgpass (chmod 600), line:  host:5432:dbname:postgres:THE_PASSWORD   -> leave the lines below commented out
#  2) A command that prints the password (secret manager):
# REMOTE_PASSWORD_CMD='aws secretsmanager get-secret-value --secret-id prod/db --query SecretString --output text | jq -r .password'
# REMOTE_PASSWORD_CMD='secret-tool lookup service easy-db-dump env prod'
# REMOTE_PASSWORD_CMD='op read "op://Private/prod-db/password"'
#  3) Plain text (this file is git-ignored, but avoid it if you can):
# REMOTE_PASSWORD=

# --- Local database (restore target) ---
LOCAL_HOST=localhost
LOCAL_PORT=5432
LOCAL_USER=postgres
LOCAL_PASSWORD=postgres
LOCAL_DB=dbname
