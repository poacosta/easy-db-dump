# One environment of one project: ~/.config/edd/projects/<project>/<env>.env
# Created by `edd init <project> <env>`.

# --- Remote database (AWS / RDS) ---
REMOTE_HOST=mydb.xxxxxxxx.us-east-1.rds.amazonaws.com
REMOTE_PORT=5432
REMOTE_USER=postgres
REMOTE_DB=dbname

# Remote password — pick ONE option (most to least recommended):
#  1) ~/.pgpass (chmod 600), line:  host:5432:dbname:postgres:THE_PASSWORD   -> leave the lines below commented out
#  2) A command that prints the password (secret manager):
# REMOTE_PASSWORD_CMD='aws secretsmanager get-secret-value --secret-id prod/db --query SecretString --output text | jq -r .password'
# REMOTE_PASSWORD_CMD='secret-tool lookup service easy-db-dump target myapp:prod'
# REMOTE_PASSWORD_CMD='op read "op://Private/myapp-prod-db/password"'
#  3) Plain text (this file is chmod 600 and lives outside any repo, but prefer 1 or 2):
# REMOTE_PASSWORD=

# --- Local database (restore target — it is DROPPED and recreated on every sync) ---
# Defaults to REMOTE_DB. Use a different name to keep several environments side by side
# (e.g. myapp_prod and myapp_staging).
LOCAL_DB=
# LOCAL_HOST / LOCAL_PORT / LOCAL_USER / LOCAL_PASSWORD are inherited from
# project.env or settings.env; set them here only if this environment differs.
