# Settings shared by every environment of this project: ~/.config/edd/projects/<project>/project.env
# Everything is optional; uncomment only what this project needs.

# Store this project's dumps in its own folder instead of <BACKUP_DIR>/<project>/
# (YYYY/MM/ subfolders are created inside it):
# PROJECT_BACKUP_DIR="$HOME/code/myapp/db"

# This project's local Postgres, e.g. a docker compose service published on another port:
# LOCAL_PORT=5433
# LOCAL_PASSWORD=postgres

# Exclude data from heavy tables you don't need locally:
# PG_DUMP_EXTRA_ARGS="--no-owner --no-privileges --exclude-table-data=audit_logs"
