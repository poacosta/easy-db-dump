# Global settings for every project: ~/.config/edd/settings.env
# Any value here can be overridden per project (project.env) or per environment (<env>.env).

# Root folder for dumps. Each project gets its own subfolder:
#   <BACKUP_DIR>/<project>/YYYY/MM/<env>_YYYYMMDD_HHMM_backup.sql
BACKUP_DIR="$HOME/db-dumps"

# `edd clean` (and the daily timer) delete dumps older than this
RETENTION_DAYS=30

# If your local pg_dump is older than the RDS server ("server version mismatch"),
# use the binaries from a Docker image matching the RDS major version:
# PG_DOCKER_IMAGE=postgres:16

# --no-owner/--no-privileges avoid RDS role errors (rdsadmin, etc.) when restoring locally
PG_DUMP_EXTRA_ARGS="--no-owner --no-privileges"

# 1 = abort the restore on the first SQL error
RESTORE_STRICT=0

# Defaults for the local Postgres, if most of your projects share one
# LOCAL_HOST=localhost
# LOCAL_PORT=5432
# LOCAL_USER=postgres
# LOCAL_PASSWORD=postgres
